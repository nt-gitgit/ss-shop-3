{% comment %}
  Rendered in the password template when password protection is on.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page full-width" style="--text-color: 359 99% 61%; --background-color: 49 14% 85%">
  <div class="password-page__inner">
    <span class="password-page__mark" aria-hidden="true">{{ 'icon-logo.svg' | inline_asset_content }}</span>
    <h1 class="ts-h2 password-page__title">{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p class="ts-body-l">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}
        <p class="error-message">{{ form.errors | default_errors }}</p>
      {% endif %}

      <div class="password-page__row">
        <input type="password" name="password" id="password-input" class="field" placeholder="{{ 'password.password' | t }}" required>
        <button type="submit" class="arrow-link">
          <span class="link-title ts-cta">{{ 'password.enter' | t }}</span>
        </button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password-page {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--grid-margin);
  }

  .password-page__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 26rem;
  }

  .password-page__mark {
    width: 32px;
    height: 32px;
  }

  .password-page__title {
    margin: 0;
  }

  .password-page__row {
    display: flex;
    gap: 12px;
    width: 100%;
  }

  .password-page__row .field {
    flex: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
