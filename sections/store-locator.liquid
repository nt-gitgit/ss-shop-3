{% comment %}
  Store locator: a light search/filter panel on the left, always black on
  white, and a dark interactive globe on the right, always white on black
  -- a fixed two-tone split rather than the site's usual theme picker,
  since that's the deliberate design here. The globe is a hand-rolled
  orthographic projection on a plain 2D canvas (no map library, no WebGL)
  textured from Natural Earth's public-domain 110m land outline, embedded
  directly in assets/store-locator.js. It spins slowly until the visitor
  drags, scrolls or picks a store, at which point it stays put.

  A store's "Open now" / "Closed" status is computed live, in that
  store's own timezone, from seven per-weekday hour ranges -- not a
  manual toggle -- so it stays correct as the day goes on. Searching or
  picking a country filter narrows both the list and the globe's dots
  together.

  Locations without both latitude and longitude still get a card; they
  just don't get a dot.

  @example
  {% section 'store-locator' %}
{% endcomment %}

{% liquid
  assign has_coordinates = false
  for block in section.blocks
    if block.settings.lat != blank and block.settings.lon != blank
      assign has_coordinates = true
    endif
  endfor

  assign summary_template = 'general.store_locator.store_summary' | t: stores: '__S__', countries: '__C__'
  assign hud_count_template = 'general.store_locator.store_count' | t: count: '__N__'
%}

<section
  id="stores"
  class="store-locator {{ section.settings.theme }} full-width"
  data-reveal
  {% if has_coordinates %}
    data-store-locator
    data-summary-template="{{ summary_template }}"
    data-no-match-label="{{ 'general.store_locator.no_match' | t }}"
    data-empty-state-label="{{ 'general.store_locator.empty_state' | t }}"
    data-hud-count-template="{{ hud_count_template }}"
    data-open-label="{{ 'general.store_locator.open_now' | t }}"
    data-closed-label="{{ 'general.store_locator.closed' | t }}"
    data-all-label="{{ 'general.store_locator.filter_all' | t }}"
  {% endif %}
>
  <div class="store-locator__panel">
    <div class="store-locator__panel-head">
      <div class="trumpet-row" data-reveal>
        <span class="trumpet-row__tick" aria-hidden="true"></span>
        <span class="trumpet">{{ section.settings.label }}</span>
      </div>
      {% if section.settings.heading != blank %}
        <h2 class="store-locator__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="store-locator__search">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="6.8" cy="6.8" r="4.6"></circle>
          <path d="M10.4 10.4 14 14"></path>
        </svg>
        <input
          type="search"
          autocomplete="off"
          data-store-locator-search
          placeholder="{{ 'general.store_locator.search_placeholder' | t }}"
          aria-label="{{ 'general.store_locator.search_placeholder' | t }}"
        >
      </div>

      <div class="store-locator__filters" data-store-locator-filters role="group" aria-label="{{ 'general.store_locator.filter_by_country' | t }}"></div>
      <p class="state-label store-locator__tally" data-store-locator-tally></p>
    </div>

    <div class="store-locator__list" data-store-locator-list></div>
  </div>

  <div class="store-locator__stage">
    {% if has_coordinates %}
      <canvas data-store-locator-globe role="application" aria-label="{{ 'general.store_locator.map_label' | t }}"></canvas>
      <div class="store-locator__hud">
        <span>{{ 'general.store_locator.drag_to_spin' | t }}</span>
        <span class="store-locator__hud-sep">·</span>
        <span class="store-locator__hud-sep">{{ 'general.store_locator.scroll_to_zoom' | t }}</span>
        <span class="store-locator__hud-count" data-store-locator-hud-count></span>
        <span class="store-locator__hud-zoom">
          <button type="button" data-store-locator-zoom-out aria-label="{{ 'general.store_locator.zoom_out' | t }}">&minus;</button>
          <button type="button" data-store-locator-zoom-in aria-label="{{ 'general.store_locator.zoom_in' | t }}">+</button>
        </span>
      </div>

      {% liquid
        assign printed = 0
      %}
      {% capture locations_json %}[{% for block in section.blocks %}{% if block.settings.lat != blank and block.settings.lon != blank %}{% if printed > 0 %},{% endif %}{"name":{{ block.settings.name | json }},"address":{{ block.settings.address | json }},"country":{{ block.settings.country | json }},"lat":{{ block.settings.lat | json }},"lon":{{ block.settings.lon | json }},"tz":{{ block.settings.timezone | json }},"hours":[{{ block.settings.hours_mon | json }},{{ block.settings.hours_tue | json }},{{ block.settings.hours_wed | json }},{{ block.settings.hours_thu | json }},{{ block.settings.hours_fri | json }},{{ block.settings.hours_sat | json }},{{ block.settings.hours_sun | json }}]}{% assign printed = printed | plus: 1 %}{% endif %}{% endfor %}]{% endcapture %}
      <script type="application/json" data-store-locator-data>{{ locations_json }}</script>
      <script src="{{ 'store-locator.js' | asset_url }}" defer="defer"></script>
    {% else %}
      {% render 'media-placeholder', class: 'store-locator__stage-placeholder' %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /**
   * Uses the section's own theme pair (defaults to beige/black with red
   * as the one constant accent) instead of a fixed black-on-white/
   * always-black split, so it reads as part of the shop rather than a
   * separate full-screen app dropped into the page.
   */
  .store-locator {
    --fg1: hsl(var(--text-color));
    --fg2: hsla(var(--text-color) / 0.6);
    --fg3: hsla(var(--text-color) / 0.35);
    --bg1: hsl(var(--background-color));
    --hairline: var(--border-color);
    --pad: var(--grid-margin);

    display: grid;
    grid-template-columns: minmax(360px, 29vw) 1fr;
    min-height: 620px;
    margin: var(--section-m) var(--grid-margin);
    font-family: var(--sans-serif);
    font-size: var(--ts-body-m-fs);
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  @media (max-width: 899px) {
    .store-locator {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) 44vh;
      margin: var(--section-s) var(--grid-margin);
    }
  }

  /* ---------- Panel ---------- */
  .store-locator__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--hairline);
    background: var(--bg1);
  }

  @media (max-width: 899px) {
    .store-locator__panel {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
  }

  .store-locator__panel-head {
    padding: var(--pad) var(--pad) 0;
    flex: 0 0 auto;
  }

  .store-locator__panel-head .trumpet-row {
    margin-bottom: 18px;
  }

  .store-locator__panel-head .trumpet {
    opacity: 0.7;
  }

  .store-locator__heading {
    font: 400 clamp(44px, 4.6vw, 68px) / 0.88 var(--display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 30px;
  }

  /* ---------- Search ---------- */
  .store-locator__search {
    position: relative;
    margin-bottom: 14px;
  }

  .store-locator__search input {
    width: 100%;
    padding: 13px 14px 13px 40px;
    font: 400 var(--ts-label-s-fs) / 1.26 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg1);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--br);
    transition: border-color var(--theme-transition);
  }

  .store-locator__search input::placeholder {
    color: var(--fg3);
  }

  .store-locator__search input:focus {
    outline: none;
    border-color: var(--fg1);
  }

  .store-locator__search svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    color: var(--fg3);
    pointer-events: none;
  }

  /* ---------- Filters ---------- */
  .store-locator__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .store-locator__filters .tag--chip {
    padding: 7px 11px;
    background: none;
    color: var(--fg1);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), background 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .store-locator__filters .tag--chip:hover {
    border-color: var(--fg1);
  }

  .store-locator__filters .tag--chip[aria-pressed='true'] {
    background: var(--fg1);
    border-color: var(--fg1);
    color: var(--bg1);
  }

  .store-locator__tally {
    opacity: 1;
    color: var(--fg3);
    padding-bottom: 16px;
  }

  /* ---------- Store list ---------- */
  .store-locator__list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    border-top: 1px solid var(--hairline);
    scrollbar-width: thin;
  }

  .store-locator__list::-webkit-scrollbar {
    width: 5px;
  }

  .store-locator__list::-webkit-scrollbar-track {
    background: transparent;
  }

  .store-locator__list::-webkit-scrollbar-thumb {
    background: var(--hairline);
    border-radius: 99px;
  }

  .store-locator__store {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 14px;
    width: 100%;
    padding: 20px var(--pad);
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--hairline);
    cursor: pointer;
    transition: background 0.3s var(--ease-out);
  }

  .store-locator__store:hover {
    background: hsla(var(--text-color) / 0.05);
  }

  .store-locator__store[aria-current='true'] {
    background: hsla(var(--color-red) / 0.12);
  }

  .store-locator__store-name {
    display: block;
    font: 500 var(--ts-body-l-fs) / 1.2 var(--sans-serif);
    letter-spacing: 0;
    margin-bottom: 5px;
  }

  .store-locator__store-addr {
    display: block;
    color: var(--fg2);
    letter-spacing: 0.01em;
  }

  .store-locator__store-status {
    display: flex;
    align-items: center;
    gap: 7px;
    font: 400 var(--ts-label-s-fs) / 1.26 var(--mono);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    color: var(--fg3);
    white-space: nowrap;
    padding-top: 3px;
  }

  .store-locator__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg3);
    flex: 0 0 auto;
  }

  .store-locator__store-status.is-open {
    color: var(--fg1);
  }

  .store-locator__store-status.is-open .store-locator__dot {
    background: var(--red);
  }

  .store-locator__empty {
    padding: 34px var(--pad);
    color: var(--fg3);
    font: 300 var(--ts-label-s-fs) / 1.6 var(--mono);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
  }

  /**
   * The globe stage shares the panel's own background rather than always
   * being a dark box -- the canvas paints its "sea" in that same colour
   * (see assets/store-locator.js), so there's no seam between the two
   * halves and nothing for the sphere to visibly crop against as it's
   * zoomed in.
   */
  .store-locator__stage {
    position: relative;
    min-height: 0;
    background: var(--bg1);
    overflow: hidden;
  }

  .store-locator__stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .store-locator__stage canvas.is-grabbing {
    cursor: grabbing;
  }

  .store-locator__hud {
    position: absolute;
    left: var(--pad);
    bottom: var(--pad);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 11px 12px 11px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--br);
    background: hsla(var(--background-color) / 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    font: 300 var(--ts-label-s-fs) / 1.26 var(--mono);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    color: var(--fg3);
  }

  .store-locator__hud-count {
    color: var(--fg1);
  }

  .store-locator__hud-zoom {
    display: flex;
    gap: 6px;
  }

  .store-locator__hud-zoom button {
    width: 27px;
    height: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg1);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--br);
    cursor: pointer;
    font: 400 12px / 1 var(--mono);
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .store-locator__hud-zoom button:hover {
    transform: scale(1.12);
    border-color: var(--fg1);
  }

  @media (max-width: 899px) {
    .store-locator__hud {
      left: var(--pad);
      right: var(--pad);
      bottom: 14px;
      gap: 12px;
      padding: 9px 10px 9px 13px;
    }

    .store-locator__hud-sep {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.store_locator",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "t:labels.theme",
      "options": [
        { "value": "theme-light", "label": "t:options.theme.light" },
        { "value": "theme-beige", "label": "t:options.theme.beige" },
        { "value": "theme-dark", "label": "t:options.theme.dark" },
        { "value": "theme-red", "label": "t:options.theme.red" },
        { "value": "theme-grey", "label": "t:options.theme.grey" },
        { "value": "", "label": "t:options.theme.custom" }
      ],
      "default": "theme-beige"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.text",
      "default": "Store locator"
    },
    {
