{% comment %}
  Site header. Sticky, with the brand mark and primary nav. The clock,
  cart toggle and newsletter signup live in the widget rail now
  (sections/widget-rail.liquid) -- the header's grid reserves an empty
  --rail-width track on the right at desktop so its content lines up with
  the rail above it, matching .ss-header-grid in the design system.

  @example
  {% section 'header' %}
{% endcomment %}

<header class="site-header full-width" data-site-header>
  <a href="{{ routes.root_url }}" class="site-header__brand">
    <span class="site-header__mark" aria-hidden="true">{{ 'icon-logo.svg' | inline_asset_content }}</span>
    <span class="site-header__wordmark">{{ shop.name }}</span>
  </a>

  <nav class="site-header__menu" aria-label="{{ 'general.accessibility.main_menu' | t }}">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    {% else %}
      {% comment %} Defaults matching the drop's own anchors -- no navigation menu has to be configured for this to work. {% endcomment %}
      <a href="{{ routes.root_url }}#drop">{{ 'general.nav.drop' | t }}</a>
      <a href="{{ routes.root_url }}#lookbook">{{ 'general.nav.lookbook' | t }}</a>
      <a href="{{ routes.root_url }}#studio">{{ 'general.nav.studio' | t }}</a>
    {% endif %}
  </nav>

  <div class="site-header__bracket-wrap" aria-hidden="true">
    <div class="ss-bracket site-header__bracket"></div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr var(--rail-width);
    align-items: center;
    gap: 24px;
    height: var(--header-height);
    padding-left: var(--grid-margin);
    background-color: hsla(var(--background-color) / 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: hsl(var(--text-color));
  }

  @media (max-width: 899px) {
    .site-header {
      grid-template-columns: auto auto;
      justify-content: space-between;
      padding-right: var(--grid-margin);
    }
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
    color: currentcolor;
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: currentcolor;
  }

  .site-header__mark svg {
    width: 100%;
    height: 100%;
  }

  .site-header__wordmark {
    font-family: var(--mono);
    font-size: var(--ts-label-s-fs);
    line-height: var(--ts-label-s-lh);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__menu {
    display: flex;
    gap: 28px;
    justify-content: center;
    overflow: hidden;
  }

  .site-header__menu a {
    color: currentcolor;
    text-decoration: none;
    font-size: var(--ts-body-s-fs);
    line-height: var(--ts-body-s-lh);
    letter-spacing: var(--ts-body-s-ls);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .site-header__menu {
      display: none;
    }
  }

  /* A down-pointing tab marking the grid extent, hanging just below the
     sticky header so it travels with it. */
  .site-header__bracket-wrap {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding-left: var(--grid-margin);
    padding-right: var(--grid-margin);
  }

  @media (min-width: 900px) {
    .site-header__bracket-wrap {
      padding-right: var(--rail-width);
    }
  }

  .site-header__bracket {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:labels.menu_info"
    }
  ]
}
{% endschema %}
