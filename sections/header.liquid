{% comment %}
  Site header. Sticky, with the brand mark, primary nav, a live Copenhagen
  clock and the cart toggle. The cart is a button that opens the AJAX
  drawer (`data-cart-toggle`), not a link to the cart page.

  @example
  {% section 'header' %}
{% endcomment %}

<header class="site-header" data-site-header>
  <a href="{{ routes.root_url }}" class="site-header__brand">
    <span class="site-header__mark" aria-hidden="true">{{ 'icon-logo.svg' | inline_asset_content }}</span>
    <span class="site-header__wordmark">{{ shop.name }}</span>
  </a>

  <nav class="site-header__menu" aria-label="{{ 'general.accessibility.main_menu' | t }}">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    {% else %}
      {% comment %} Defaults matching the drop's own anchors -- no navigation menu has to be configured for this to work. {% endcomment %}
      <a href="{{ routes.root_url }}#drop">{{ 'general.nav.drop' | t }}</a>
      <a href="{{ routes.root_url }}#black-friday">{{ 'general.nav.black_friday' | t }}</a>
      <a href="{{ routes.root_url }}#lookbook">{{ 'general.nav.lookbook' | t }}</a>
      <a href="{{ routes.root_url }}#studio">{{ 'general.nav.studio' | t }}</a>
    {% endif %}
  </nav>

  <div class="site-header__meta">
    {% if section.settings.show_clock %}
      <span class="site-header__clock">
        {% render 'clock', timezone: section.settings.timezone, show_readout: true %}
        {% if section.settings.city != blank %}
          <span>{{ section.settings.city }}</span>
        {% endif %}
      </span>
    {% endif %}

    <button type="button" class="site-header__cart ts-label-s" data-cart-toggle>
      {{ 'general.accessibility.cart' | t }} [<span data-cart-count>{{ cart.item_count }}</span>]
    </button>
  </div>

  <div class="site-header__bracket-wrap" aria-hidden="true">
    <div class="ss-bracket site-header__bracket"></div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    height: var(--header-height);
    padding: 0 20px 0 var(--grid-margin);
    background-color: hsla(var(--background-color) / 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: hsl(var(--text-color));
  }

  @media (max-width: 899px) {
    .site-header {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
    color: currentcolor;
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: currentcolor;
  }

  .site-header__mark svg {
    width: 100%;
    height: 100%;
  }

  .site-header__wordmark {
    font-family: var(--mono);
    font-size: var(--ts-label-s-fs);
    line-height: var(--ts-label-s-lh);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__menu {
    display: flex;
    gap: 28px;
    justify-content: center;
    overflow: hidden;
  }

  .site-header__menu a {
    color: currentcolor;
    text-decoration: none;
    font-size: var(--ts-body-s-fs);
    line-height: var(--ts-body-s-lh);
    letter-spacing: var(--ts-body-s-ls);
    white-space: nowrap;
  }

  .site-header__meta {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 18px;
    flex-shrink: 0;
  }

  .site-header__clock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: var(--ts-label-s-fs);
    line-height: var(--ts-label-s-lh);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0.55;
  }

  .site-header__cart {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: currentcolor;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--br);
    padding: 6px 10px;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
  }

  .site-header__cart:hover {
    background-color: hsl(var(--text-color));
    color: hsl(var(--background-color));
  }

  @media (max-width: 700px) {
    .site-header__menu {
      display: none;
    }
  }

  /* A down-pointing tab marking the grid extent, hanging just below the
     sticky header so it travels with it. */
  .site-header__bracket-wrap {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding-inline: var(--grid-margin);
  }

  .site-header__bracket {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:labels.menu_info"
    },
    {
      "type": "checkbox",
      "id": "show_clock",
      "label": "t:labels.show_clock",
      "default": true
    },
    {
      "type": "text",
      "id": "city",
      "label": "t:labels.city",
      "default": "Copenhagen"
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "t:labels.timezone",
      "info": "t:labels.timezone_info",
      "default": "Europe/Copenhagen"
    }
  ]
}
{% endschema %}
