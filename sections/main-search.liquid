{% comment %}
  Search: a mono input form and a results grid, reusing the product card
  for product results and a simple text row for pages/articles.

  @example
  {% section 'main-search' %}
{% endcomment %}

<div class="search-page full-width" data-reveal>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input type="hidden" name="type" value="product,page,article">
    <input
      type="search"
      name="q"
      class="field search-page__input"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      aria-label="{{ 'search.placeholder' | t }}"
    >
    <button type="submit" class="arrow-link search-page__submit">
      <span class="link-title ts-cta">{{ 'search.submit' | t }}</span>
    </button>
  </form>

  {% if search.performed %}
    <p class="ts-label-s search-page__meta">
      {% if search.results_count > 0 %}
        {{ 'search.results_for_html' | t: count: search.results_count, terms: search.terms }}
      {% else %}
        {{ 'search.no_results_html' | t: terms: search.terms }}
      {% endif %}
    </p>

    {% if search.results_count > 0 %}
      <div class="search-page__grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% else %}
            <a href="{{ item.url }}" class="search-page__result">
              <span class="ts-body-l">{{ item.title }}</span>
              <span class="ts-label-s search-page__result-type">{{ item.object_type }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search-page {
    padding: var(--section-s) var(--grid-margin) var(--section-l);
  }

  .search-page__form {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
    margin-bottom: 32px;
  }

  .search-page__input {
    border: 0;
    border-radius: 0;
    padding: 0;
    font-size: var(--ts-body-xl-fs);
    font-family: var(--sans-serif);
  }

  .search-page__meta {
    opacity: 0.6;
    margin-bottom: 24px;
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 899px) {
    .search-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .search-page__result {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: currentcolor;
    padding-block: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .search-page__result-type {
    opacity: 0.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
