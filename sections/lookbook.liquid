{% comment %}
  A lookbook grid: up to four images, each a block with its own aspect
  ratio and caption, arranged in the house's asymmetric 12-column rhythm.

  @example
  {% section 'lookbook' %}
{% endcomment %}

<div id="lookbook" class="lookbook {{ section.settings.theme }} full-width" data-reveal>
  <div class="trumpet-row lookbook__label">
    <span class="trumpet-row__tick" aria-hidden="true"></span>
    <span class="trumpet">{{ section.settings.label }}</span>
  </div>

  <div class="lookbook__grid">
    {% for block in section.blocks %}
      <figure class="lookbook__item lookbook__item--span-{{ block.settings.span }}" {{ block.shopify_attributes }}>
        <div class="lookbook__media" style="aspect-ratio: {{ block.settings.aspect_ratio }}">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', class: 'lookbook__image'
            }}
          {% else %}
            {% render 'media-placeholder', class: 'lookbook__placeholder', label: block.settings.placeholder_label %}
          {% endif %}
        </div>
        {% if block.settings.caption != blank %}
          <figcaption class="ts-label-s lookbook__caption">{{ block.settings.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .lookbook {
    padding: 88px var(--grid-margin);
  }

  .lookbook__label {
    margin-bottom: 36px;
  }

  .lookbook__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
  }

  .lookbook__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    grid-column: span 12;
  }

  @media (min-width: 900px) {
    .lookbook__item--span-5 {
      grid-column: span 5;
    }
    .lookbook__item--span-7 {
      grid-column: span 7;
    }
    .lookbook__item--span-12 {
      grid-column: span 12;
    }
  }

  .lookbook__media {
    position: relative;
    border-radius: var(--br);
    overflow: hidden;
    background: hsla(var(--text-color) / 0.06);
  }

  .lookbook__image,
  .lookbook__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .lookbook__caption {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.lookbook",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "t:labels.theme",
      "options": [
        { "value": "theme-light", "label": "t:options.theme.light" },
        { "value": "theme-dark", "label": "t:options.theme.dark" },
        { "value": "theme-beige", "label": "t:options.theme.beige" },
        { "value": "theme-red", "label": "t:options.theme.red" },
        { "value": "theme-grey", "label": "t:options.theme.grey" },
        { "value": "", "label": "t:options.theme.custom" }
      ],
      "default": "theme-red"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.text",
      "default": "Lookbook — worn in, mostly at work"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:labels.image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "t:labels.placeholder",
          "default": "Image, 2000x1500"
        },
        {
          "type": "select",
          "id": "span",
          "label": "t:labels.grid_item_width",
          "options": [
            { "value": "5", "label": "5 / 12" },
            { "value": "7", "label": "7 / 12" },
            { "value": "12", "label": "12 / 12" }
          ],
          "default": "7"
        },
        {
          "type": "text",
          "id": "aspect_ratio",
          "label": "t:labels.aspect_ratio",
          "info": "t:labels.aspect_ratio_info",
          "default": "4/3"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.lookbook",
      "blocks": [
        { "type": "image", "settings": { "span": "7", "aspect_ratio": "4/3", "caption": "01 — Monday, 09:12. The hoodie has never left the building." } },
        { "type": "image", "settings": { "span": "5", "aspect_ratio": "4/5", "caption": "02 — Cap, worn by a producer who insists it's for the sun." } },
        { "type": "image", "settings": { "span": "5", "aspect_ratio": "4/3", "caption": "03 — Nikolaj Plads to Torvehallerne, four minutes." } },
        { "type": "image", "settings": { "span": "7", "aspect_ratio": "16/9", "caption": "04 — One colour. One pass. One list of ten things." } }
      ]
    }
  ]
}
{% endschema %}
