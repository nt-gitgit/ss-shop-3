{% comment %}
  The cart drawer. Rendered once in layout/theme.liquid via {% section
  'cart-drawer' %}, and re-fetched by assets/cart.js through the Section
  Rendering API (?section_id=cart-drawer) after every add/update/remove so
  the drawer never needs a hand-rolled JSON-to-HTML renderer.

  @example
  {% section 'cart-drawer' %}
{% endcomment %}

<cart-drawer class="cart-drawer" data-cart-drawer hidden {% if cart.item_count == 0 %}data-empty{% endif %}>
  <div class="cart-drawer__backdrop" data-cart-close></div>

  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <p class="ts-label-m">{{ 'shop.cart_headline' | t: quantity: cart.item_count }}</p>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'general.close' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {% if cart.item_count > 0 %}
      {% liquid
        assign threshold_cents = settings.free_shipping_threshold | times: 100
        assign remaining_cents = threshold_cents | minus: cart.total_price
        assign remaining_money = remaining_cents | money
        assign pct = 100
        if threshold_cents > 0
          assign pct = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100
        endif
      %}
      {% if threshold_cents > 0 %}
        <div class="cart-drawer__shipping-bar">
          {% if remaining_cents > 0 %}
            <p class="ts-body-s">{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}</p>
          {% else %}
            <p class="ts-body-s">{{ 'cart.free_shipping_unlocked' | t }}</p>
          {% endif %}
          <div class="cart-drawer__progress hairline">
            <div class="cart-drawer__progress-fill" style="width: {{ pct }}%"></div>
          </div>
        </div>
      {% endif %}

      <div class="cart-drawer__lines" data-cart-lines>
        {% for item in cart.items %}
          {% render 'cart-line-item', item: item %}
        {% endfor %}
      </div>

      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span class="ts-body-s">{{ 'cart.subtotal' | t }}</span>
          <span class="ts-body-s ff-mono">{{ cart.total_price | money }}</span>
        </div>
        <p class="ts-body-s cart-drawer__note">{{ 'cart.taxes_shipping_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="arrow-link cart-drawer__checkout" data-checkout-button>
            <span class="link-title ts-cta">{{ 'shop.pay_now' | t }}</span>
            <span class="button__icon" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
        </form>
      </div>
    {% else %}
      <div class="cart-drawer__empty">
        <p class="ts-body-l">{{ 'cart.empty_html' | t }}</p>
        <a class="arrow-link" href="{{ section.settings.empty_cart_link | default: routes.all_products_collection_url }}" data-cart-close>
          <span class="link-title ts-cta">{{ 'cart.browse_collection' | t }}</span>
          <span class="button__icon" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</cart-drawer>

{% stylesheet %}
  .cart-drawer[hidden] {
    display: none;
  }

  .cart-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: hsla(var(--text-color) / 0.15);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
    z-index: 200;
  }

  .cart-drawer.is-open .cart-drawer__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer__panel {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: min(26rem, 100vw);
    background-color: hsla(var(--background-color) / 0.9);
    backdrop-filter: blur(60px);
    -webkit-backdrop-filter: blur(60px);
    color: hsl(var(--text-color));
    border-left: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    padding: var(--grid-margin);
    transform: translateX(100%);
    transition: transform 500ms var(--ease-in-out);
    z-index: 201;
  }

  .cart-drawer.is-open .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .cart-drawer__close {
    background: none;
    border: none;
    width: 1rem;
    height: 1rem;
    color: currentcolor;
    cursor: pointer;
    padding: 0;
  }

  .cart-drawer__close svg {
    width: 100%;
    height: 100%;
  }

  .cart-drawer__shipping-bar {
    padding-block: 1rem;
    display: grid;
    gap: 0.6rem;
  }

  .cart-drawer__progress {
    height: 2px;
    overflow: hidden;
    border: 0;
    border-radius: 2px;
    background: var(--border-color);
  }

  .cart-drawer__progress-fill {
    height: 100%;
    background: currentcolor;
    transition: width 500ms var(--ease-out);
  }

  .cart-drawer__lines {
    flex: 1;
    overflow-y: auto;
  }

  .cart-drawer__footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    display: grid;
    gap: 0.6rem;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
  }

  .cart-drawer__note {
    opacity: 0.55;
  }

  .cart-drawer__checkout {
    width: 100%;
    justify-content: center;
    padding: 0.9rem;
    border: 1px solid currentcolor;
    border-radius: var(--br);
    max-width: none;
  }

  .cart-drawer__empty {
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart_drawer",
  "settings": [
    {
      "type": "url",
      "id": "empty_cart_link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
