{% comment %}
  The cart drawer. Rendered once in layout/theme.liquid via {% section
  'cart-drawer' %}, and re-fetched by assets/cart.js through the Section
  Rendering API (?section_id=cart-drawer) after every add/update/remove so
  the drawer never needs a hand-rolled JSON-to-HTML renderer.

  @example
  {% section 'cart-drawer' %}
{% endcomment %}

<cart-drawer class="cart-drawer" data-cart-drawer hidden {% if cart.item_count == 0 %}data-empty{% endif %}>
  <div class="cart-drawer__backdrop" data-cart-close></div>

  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <span class="ts-label-s">{{ 'cart.bag' | t }} [<span data-cart-count>{{ cart.item_count }}</span>]</span>
      <button type="button" class="cart-drawer__close ts-label-s" data-cart-close>
        {{ 'general.close' | t }}
      </button>
    </div>

    {% if cart.item_count > 0 %}
      {% liquid
        assign threshold_cents = settings.free_shipping_threshold | times: 100
        assign remaining_cents = threshold_cents | minus: cart.total_price
        assign remaining_money = remaining_cents | money
        assign pct = 100
        if threshold_cents > 0
          assign pct = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100
        endif
      %}
      {% if threshold_cents > 0 %}
        <div class="cart-drawer__shipping-bar">
          {% if remaining_cents > 0 %}
            <p class="ts-body-s">{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}</p>
          {% else %}
            <p class="ts-body-s">{{ 'cart.free_shipping_unlocked' | t }}</p>
          {% endif %}
          <div class="cart-drawer__progress hairline">
            <div class="cart-drawer__progress-fill" style="width: {{ pct }}%"></div>
          </div>
        </div>
      {% endif %}

      <div class="cart-drawer__lines" data-cart-lines>
        {% for item in cart.items %}
          {% render 'cart-line-item', item: item %}
        {% endfor %}
      </div>

      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal ts-label-m">
          <span style="opacity: 0.6">{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="ts-label-s cart-drawer__note">{{ 'cart.taxes_shipping_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="cart-drawer__checkout ts-cta" data-checkout-button>
            {{ 'shop.pay_now' | t }}
          </button>
        </form>
      </div>
    {% else %}
      <div class="cart-drawer__empty">
        <p class="ts-body-s" style="opacity: 0.55">{{ 'cart.empty_html' | t }}</p>
      </div>
    {% endif %}
  </div>
</cart-drawer>

{% stylesheet %}
  .cart-drawer[hidden] {
    display: none;
  }

  .cart-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: hsla(var(--text-color) / 0.22);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
    z-index: 200;
  }

  .cart-drawer.is-open .cart-drawer__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer__panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 92vw);
    background-color: hsla(var(--background-color) / 0.9);
    backdrop-filter: blur(60px);
    -webkit-backdrop-filter: blur(60px);
    color: hsl(var(--text-color));
    border-left: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    transform: translateX(101%);
    transition: transform 500ms var(--ease-in-out);
    z-index: 201;
  }

  .cart-drawer.is-open .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
  }

  .cart-drawer__close {
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--br);
    padding: 6px 9px;
    color: currentcolor;
    cursor: pointer;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
  }

  .cart-drawer__close:hover {
    background-color: hsl(var(--text-color));
    color: hsl(var(--background-color));
  }

  .cart-drawer__shipping-bar {
    padding: 20px;
    display: grid;
    gap: 0.6rem;
    border-bottom: 1px solid var(--border-color);
  }

  .cart-drawer__progress {
    height: 2px;
    overflow: hidden;
    border: 0;
    border-radius: 2px;
    background: var(--border-color);
  }

  .cart-drawer__progress-fill {
    height: 100%;
    background: currentcolor;
    transition: width 500ms var(--ease-out);
  }

  .cart-drawer__lines {
    flex: 1;
    overflow-y: auto;
    padding: 0 20px;
  }

  .cart-drawer__footer {
    padding: 20px;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
  }

  .cart-drawer__note {
    opacity: 0.55;
  }

  .cart-drawer__checkout {
    width: 100%;
    text-align: center;
    padding: 14px;
    border: 1px solid hsl(var(--text-color));
    border-radius: var(--br);
    background: hsl(var(--text-color));
    color: hsl(var(--background-color));
    cursor: pointer;
    transition: opacity 300ms var(--ease-out);
  }

  .cart-drawer__checkout:hover {
    opacity: 0.85;
  }

  .cart-drawer__empty {
    display: grid;
    gap: 1rem;
    padding: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart_drawer",
  "settings": [
    {
      "type": "url",
      "id": "empty_cart_link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
