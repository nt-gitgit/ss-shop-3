{% doc %}
  A product teaser: full-bleed photography with the title set top left and
  a meta row bottom left. No border, no shadow, no card chrome. A row of
  quick-add pills sits below -- one per variant when the product has real
  options (sizes), or a single "Add to bag" pill when it doesn't. Clicking a
  pill adds that variant straight to the cart; no separate add step.

  @param {product} product - The product to render
  @param {number} [reveal_delay] - Seconds to delay the scroll reveal, for staggering a grid
  @param {string} [index] - A two-digit index label, top left of the media

  @example
  {% render 'product-card', product: product, reveal_delay: 0.08, index: '01' %}
{% enddoc %}

<div class="product-card" data-reveal style="--reveal-delay: {{ reveal_delay | default: 0 }}s">
  <a href="{{ product.url }}" class="product-card__media">
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 800
        | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 900px) 33vw, 50vw'
      }}
    {% else %}
      {% render 'media-placeholder', class: 'product-card__placeholder' %}
    {% endif %}
    {% if index %}
      <span class="ts-label-s product-card__index">{{ index }}</span>
    {% endif %}
  </a>

  <div class="product-card__meta">
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <span class="ts-label-m product-card__price">
      {% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price | money }}
    </span>
  </div>

  {% if product.description != blank %}
    <p class="ts-body-s product-card__description">{{ product.description | strip_html | truncatewords: 14 }}</p>
  {% endif %}

  <form method="post" action="{{ routes.cart_add_url }}" data-product-form class="product-card__variants">
    {% if product.has_only_default_variant %}
      {% assign variant = product.selected_or_first_available_variant %}
      <button
        type="submit"
        name="id"
        value="{{ variant.id }}"
        class="product-card__pill"
        data-add-to-cart
        {% unless variant.available %}disabled{% endunless %}
      >
        {% if variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}
      </button>
    {% else %}
      {% for variant in product.variants %}
        <button
          type="submit"
          name="id"
          value="{{ variant.id }}"
          class="product-card__pill {% unless variant.available %}product-card__pill--sold-out{% endunless %}"
          data-add-to-cart
          {% unless variant.available %}disabled{% endunless %}
        >
          {% if variant.available %}
            {{ variant.title }}
          {% else %}
            {{ variant.title }} &mdash; {{ 'products.sold_out' | t }}
          {% endif %}
        </button>
      {% endfor %}
    {% endif %}
  </form>
</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .product-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--br);
    overflow: hidden;
    aspect-ratio: 1 / 1.15;
    background: hsla(var(--text-color) / 0.09);
  }

  .product-card__media img,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .product-card__media:hover img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__media img {
      transition: none;
    }

    .product-card__media:hover img {
      transform: none;
    }
  }

  .product-card__index {
    position: absolute;
    top: 12px;
    left: 12px;
    opacity: 0.6;
  }

  .product-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .product-card__title {
    font-family: var(--sans-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: currentcolor;
  }

  .product-card__price {
    opacity: 0.7;
    white-space: nowrap;
  }

  .product-card__description {
    opacity: 0.6;
    max-width: 34ch;
    margin: 0;
  }

  .product-card__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .product-card__pill {
    font-family: var(--mono);
    font-size: var(--ts-label-s-fs);
    letter-spacing: var(--ts-label-s-ls);
    text-transform: uppercase;
    padding: 8px 11px;
    border: 1px solid var(--border-color);
    border-radius: var(--br);
    background: transparent;
    color: currentcolor;
    cursor: pointer;
    transition: background-color 250ms var(--ease-out), color 250ms var(--ease-out);
  }

  .product-card__pill:hover:not(:disabled) {
    background-color: hsl(var(--text-color));
    color: hsl(var(--background-color));
  }

  .product-card__pill:disabled {
    opacity: 0.4;
    border-style: dashed;
    cursor: not-allowed;
  }
{% endstylesheet %}
