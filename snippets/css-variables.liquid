{% doc %}
  Tokens: faces, the theme contract, the type scale, layout, surface and
  motion. A direct port of the agency's own design-system tokens
  (colors_and_type.css / grid.css) for its Black Friday merch drop — same
  literal clamp()/px values as the source, not a rescaled approximation.

  The theme contract: --text-color and --background-color hold bare HSL
  components with no hsl() wrapper, so consumers can write
  hsla(var(--text-color) / .2) for a hairline. The named presets below sit
  on top of that contract. They are a convenience, not the system: any
  container can carry its own pair. This shop's default pair (signal red
  on stone) is itself just one custom pair, not one of the five presets.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Brand typefaces, self-hosted under the studio's own font license %}
  @font-face {
    font-family: 'Grotesk';
    src: url('{{ 'PPRightGrotesk-CompactBlack.woff2' | asset_url }}') format('woff2');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Montreal';
    src: url('{{ 'PPNeueMontreal-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Supply';
    src: url('{{ 'PPSupplyMono-Light.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Noto';
    src: url('{{ 'noto-sans-tc.woff2' | asset_url }}') format('woff2');
    font-display: swap;
  }

  :root {
    {% # Chrome palette, bare components so alpha variants work %}
    --color-white: 0 0% 100%;
    --color-black: 0 0% 0%;
    --color-grey: 0 0% 21%;
    --color-beige: 49 14% 85%;
    --color-red: 359 99% 61%;

    --white: hsl(var(--color-white));
    --black: hsl(var(--color-black));
    --red: hsl(var(--color-red));

    {% # Faces %}
    --display: 'Grotesk', 'Impact', 'Haettenschweiler', sans-serif;
    --sans-serif: 'Montreal', 'Neue Haas Grotesk', 'Helvetica Neue', sans-serif;
    --mono: 'Supply', ui-monospace, 'SF Mono', monospace;
    --chinese: 'Noto', 'Noto Sans TC', sans-serif;
    --font-weight: 400;

    {% # Type scale — literal, same as the source design system %}
    --ts-h1-fs: clamp(86px, 10.5vw, 280px);
    --ts-h1-lh: 0.76;
    --ts-h1-ls: -0.01em;

    --ts-h2-fs: clamp(56px, 8vw, 140px);
    --ts-h2-lh: 1;
    --ts-h2-ls: 0.02em;

    --ts-body-xl-fs: clamp(24px, 3vw, 40px);
    --ts-body-xl-lh: 1.1;
    --ts-body-xl-ls: 0.02em;

    --ts-body-menu-fs: clamp(16px, 2vw, 20px);
    --ts-body-menu-lh: 1.4;
    --ts-body-menu-ls: 0.02em;

    --ts-body-l-fs: clamp(15px, 2vw, 18px);
    --ts-body-l-lh: 1.4;
    --ts-body-l-ls: 0.02em;

    --ts-body-m-fs: 14px;
    --ts-body-m-lh: 1.5;
    --ts-body-m-ls: 0.02em;

    --ts-body-s-fs: 12px;
    --ts-body-s-lh: 1.3;
    --ts-body-s-ls: 0.023em;

    --ts-body-xs-fs: 10px;
    --ts-body-xs-lh: normal;
    --ts-body-xs-ls: 0.02em;

    --ts-label-m-fs: 12px;
    --ts-label-m-lh: 1.3;
    --ts-label-m-ls: 0.01em;

    --ts-label-s-fs: 10px;
    --ts-label-s-lh: 1.26;
    --ts-label-s-ls: 0.01em;

    --ts-cta-fs: 12px;
    --ts-cta-lh: 1.26;
    --ts-cta-ls: 0.01em;

    {% # Layout — literal px, matching grid.css exactly %}
    --unit: 10px;
    --br: 4px;
    --header-height: 52px;
    --grid-cols: 6;
    --grid-margin: 20px;
    --grid-gap: 20px;
    --hairline-w: 1px;

    {% # One column plus one gap, and one gap on its own %}
    --gutter: var(--grid-gap);
    --cols: calc(
      (100vw - var(--grid-margin) * 2 + var(--grid-gap)) / var(--grid-cols)
    );

    {% # Section rhythm, a fallback for pages the mockup didn't cover %}
    --section-s: 48px;
    --section-m: 80px;
    --section-l: 120px;

    {% # Motion, circular eases only %}
    --ease-out: cubic-bezier(0, 0.55, 0.45, 1);
    --ease-in-out: cubic-bezier(0.85, 0, 0.15, 1);
    --theme-transition-duration: 400ms;
    --theme-transition-ease: var(--ease-out);
    --theme-transition: var(--theme-transition-duration) var(--theme-transition-ease);
  }

  @media (min-width: 900px) {
    :root {
      --grid-cols: 12;
      --grid-margin: 54px;
    }
  }

  {% # Theme presets, matching the source's five theme classes %}
  .theme-light {
    --text-color: 0 0% 0%;
    --background-color: 0 0% 100%;
  }

  .theme-dark {
    --text-color: 0 0% 100%;
    --background-color: 0 0% 0%;
  }

  .theme-stone {
    --text-color: 0 0% 0%;
    --background-color: 49 14% 85%;
  }

  .theme-red {
    --text-color: 49 14% 85%;
    --background-color: 359 99% 61%;
  }

  .theme-grey {
    --text-color: 0 0% 100%;
    --background-color: 0 0% 21%;
  }

  {% # This shop's own default: signal red set on warm stone, not the system default %}
  body {
    --text-color: 359 99% 61%;
    --background-color: 49 14% 85%;
  }

  {% # Anything carrying a pair paints itself, derives its hairline tokens from that same pair, and transitions between pairs %}
  [class*='theme-'],
  [style*='--text-color'],
  body {
    color: hsl(var(--text-color));
    background-color: hsl(var(--background-color));
    --border-color: hsla(var(--text-color) / 0.2);
    --detail-color: hsla(var(--text-color) / 0.2);
    transition: color var(--theme-transition), background-color var(--theme-transition),
      fill var(--theme-transition);
  }
{% endstyle %}
