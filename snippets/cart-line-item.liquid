{% doc %}
  Renders one cart line item. Shared between the cart drawer and the cart
  page so quantity/remove markup and data attributes stay in one place for
  assets/cart.js and assets/cart-page.js to bind to.

  @param {object} item - a cart line item

  @example
  {% render 'cart-line-item', item: item %}
{% enddoc %}

<div class="cart-line" data-cart-line data-line-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-line__media">
    {% if item.image %}
      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt }}
    {% endif %}
  </a>

  <div class="cart-line__content">
    <span class="ts-body-s">{{ item.product.title }}</span>
    <span class="ts-label-s cart-line__meta">
      {% unless item.variant.title == 'Default Title' %}{{ item.variant.title }} &middot; {% endunless %}{{ item.price | money }}
    </span>
    <div class="cart-line__controls">
      <button type="button" class="cart-line__step" data-quantity-decrease aria-label="{{ 'cart.decrease_quantity' | t }}">&minus;</button>
      <input
        type="number"
        min="0"
        value="{{ item.quantity }}"
        class="cart-line__qty ts-label-s"
        data-quantity-input
        aria-label="{{ 'cart.quantity' | t }}"
      >
      <button type="button" class="cart-line__step" data-quantity-increase aria-label="{{ 'cart.increase_quantity' | t }}">&plus;</button>
      <button type="button" class="ts-label-s cart-line__remove" data-cart-remove aria-label="{{ 'cart.remove' | t }}">{{ 'cart.remove' | t }}</button>
    </div>
  </div>

  <span class="ts-label-m cart-line__total">{{ item.final_line_price | money }}</span>
</div>

{% stylesheet %}
  .cart-line {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: start;
    padding-block: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .cart-line__media {
    display: block;
    background: hsla(var(--text-color) / 0.1);
    border-radius: var(--br);
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
  }

  .cart-line__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-line__content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cart-line__meta {
    opacity: 0.55;
  }

  .cart-line__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-line__step {
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1;
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-color);
    border-radius: var(--br);
    background: transparent;
    color: currentcolor;
    cursor: pointer;
  }

  .cart-line__qty {
    width: 22px;
    min-width: 14px;
    text-align: center;
    background: transparent;
    border: 0;
    color: currentcolor;
    -moz-appearance: textfield;
  }

  .cart-line__qty::-webkit-outer-spin-button,
  .cart-line__qty::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-line__remove {
    margin-left: 6px;
    background: transparent;
    border: 0;
    color: currentcolor;
    opacity: 0.5;
    cursor: pointer;
  }

  .cart-line__remove:hover {
    opacity: 1;
  }

  .cart-line__total {
    opacity: 0.7;
  }
{% endstylesheet %}
