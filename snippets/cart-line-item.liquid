{% doc %}
  Renders one cart line item. Shared between the cart drawer and the cart
  page so quantity/remove markup and data attributes stay in one place for
  assets/cart.js and assets/cart-page.js to bind to.

  @param {object} item - a cart line item

  @example
  {% render 'cart-line-item', item: item %}
{% enddoc %}

<div class="cart-line" data-cart-line data-line-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-line__media">
    {% if item.image %}
      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt }}
    {% else %}
      {% render 'media-placeholder', class: 'cart-line__placeholder' %}
    {% endif %}
  </a>

  <div class="cart-line__content">
    <div class="cart-line__title-row">
      <a href="{{ item.url }}" class="ts-body-s cart-line__title">{{ item.product.title }}</a>
      <button type="button" class="cart-line__remove" data-cart-remove aria-label="{{ 'cart.remove' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {% unless item.variant.title == 'Default Title' %}
      <p class="ts-label-s cart-line__variant">{{ item.variant.title }}</p>
    {% endunless %}

    <div class="cart-line__row">
      <div class="quantity-selector" data-quantity-selector>
        <button type="button" data-quantity-decrease aria-label="{{ 'cart.decrease_quantity' | t }}">
          {{ 'icon-minus.svg' | inline_asset_content }}
        </button>
        <input
          type="number"
          min="0"
          value="{{ item.quantity }}"
          data-quantity-input
          aria-label="{{ 'cart.quantity' | t }}"
        >
        <button type="button" data-quantity-increase aria-label="{{ 'cart.increase_quantity' | t }}">
          {{ 'icon-plus.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="price ff-mono">
        {% if item.original_line_price != item.final_line_price %}
          <span class="price__compare-at">{{ item.original_line_price | money }}</span>
        {% endif %}
        <span class="price__amount ts-body-s">{{ item.final_line_price | money }}</span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .cart-line {
    display: flex;
    gap: 0.9rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border-color);
  }

  .cart-line__media {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--br);
    overflow: hidden;
    flex-shrink: 0;
    display: block;
  }

  .cart-line__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-line__placeholder {
    aspect-ratio: 1 / 1;
  }

  .cart-line__content {
    flex: 1;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .cart-line__title-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cart-line__title {
    text-decoration: none;
    color: currentcolor;
  }

  .cart-line__remove {
    background: none;
    border: none;
    cursor: pointer;
    color: currentcolor;
    width: 0.9rem;
    height: 0.9rem;
    padding: 0;
    opacity: 0.55;
    flex-shrink: 0;
  }

  .cart-line__remove:hover {
    opacity: 1;
  }

  .cart-line__remove svg {
    width: 100%;
    height: 100%;
  }

  .cart-line__variant {
    opacity: 0.6;
  }

  .cart-line__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
{% endstylesheet %}
